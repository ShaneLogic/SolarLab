+    def last_step_snapshot(self, *, expected_step=None):
+        """Observe one fully witnessed accepted interval without advancing it.
+
+        The returned mapping and nested metadata are read-only. Vector buffers
+        are immutable bytes; decode with ``np.frombuffer(buffer, dtype=...
+        ).reshape(shape)`` using the packet's dtype and shape. ``dky[k]`` is
+        the rounded native derivative of order k at tn, not an exact internal
+        coefficient export. Error weights and local estimates are diagnostic.
+
+        Only adjacent, actually observed native endpoints with a step-count
+        increment of one are eligible. NORMAL calls that hide intermediate
+        steps, or returns at a time different from tn, can make the snapshot
+        unavailable. Subsequent observed consecutive endpoints restore it;
+        this operation never changes NORMAL behavior or invents a predecessor.
+        Both predecessor time and tn-hused terms are retained independently.
+
+        Pass a previously returned step_key as expected_step to reject a stale
+        owner, generation or step. Arbitrary query times and orders are not
+        accepted: all legal orders are read at tn. Event sides and input laws
+        belong to the caller. This experimental patch requires a build identity
+        bound by its accompanying reproducible build helper.
+        """
+        return self._IDA.last_step_snapshot(expected_step=expected_step)
+
 
