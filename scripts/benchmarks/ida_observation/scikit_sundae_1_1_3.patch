+def _validate_parent_weight_frame(value):
+    if value is None:
+        return None
+    keys = {"schema", "frame_identity", "t0_hex", "size", "q0_words_hex", "v0_words_hex", "weight_rounding"}
+    if (type(value) is not dict or set(value) != keys
+            or value["schema"] != "sksundae.ida.parent-affine-weights.v1"
+            or value["weight_rounding"] != "RN-exact-parent-q_then-unfused-SV-v1"
+            or type(value["size"]) is not int or not 1 <= value["size"] <= 1000000
+            or type(value["frame_identity"]) is not str or len(value["frame_identity"]) != 64
+            or any(c not in "0123456789abcdef" for c in value["frame_identity"])):
+        raise ValueError("invalid parent_weight_frame binding")
+    def word(v):
+        if type(v) is not str:
+            raise ValueError("parent_weight_frame requires exact hex words")
+        number = float.fromhex(v)
+        if not math.isfinite(number) or number.hex() != v:
+            raise ValueError("noncanonical parent_weight_frame word")
+        return number
+    word(value["t0_hex"])
+    for key in ("q0_words_hex", "v0_words_hex"):
+        rows = value[key]
+        if type(rows) is not list or len(rows) != 4 or any(type(r) is not list or len(r) != value["size"] for r in rows):
+            raise ValueError("parent_weight_frame shape")
+        numbers = [[word(v) for v in row] for row in rows]
+        for terms in zip(*numbers):
+            prefix = []
+            for supplied in terms:
+                rounded = math.fsum((*terms, *(-v for v in prefix)))
+                if supplied != rounded:
+                    raise ValueError("unnormalized parent_weight_frame words")
+                prefix.append(supplied)
+    return deepcopy(value)
